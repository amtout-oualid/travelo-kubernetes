# Nginx configuration of the Travelo frontend container.
# ${BACKEND_URL} is replaced at container start by the official image's entrypoint (envsubst),
# so the backend address is configurable without rebuilding the image.
server {
    listen 3000;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS server: resolves container/service names at request time,
    # so Nginx starts even if the backend is not up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # API calls are forwarded to the backend (same origin for the browser: no CORS issue)
    location /api/ {
        set $backend ${BACKEND_URL};
        proxy_pass $backend;
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # React Router: every unknown path returns index.html (single-page application)
    location / {
        try_files $uri /index.html;
    }

    # Static assets have hashed names: they can be cached for a long time
    location /static/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    server_tokens off;   # do not reveal the Nginx version

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;
    gzip_proxied any;
    gzip_min_length 256;
}
